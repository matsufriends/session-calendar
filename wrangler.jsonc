{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "session-calendar",
  "main": "cloud/worker.mjs",
  "compatibility_date": "2026-10-03",
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "directory": "cloud/public", "binding": "ASSETS", "run_worker_first": true },
  "vars": { "ACCESS_TEAM_DOMAIN": "", "ACCESS_AUD": "", "VIEWER_EMAIL": "" }
  // After approval, bind a dedicated namespace as SESSIONS. No automatic resource provisioning.
  // SYNC_TOKEN is a Worker secret, never a var or committed file.
}
